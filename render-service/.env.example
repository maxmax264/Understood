# Copy this to Render's Environment tab (not to a committed .env file).

# Service account JSON, base64-encoded (single line).
# Get it: Firebase Console -> Project Settings -> Service accounts
#         -> Generate new private key -> downloads a .json file.
# Then run:  base64 -w0 service-account.json   (Linux/Mac)
#            [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) (PowerShell)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Realtime Database URL, e.g. https://sionyx-19636-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Must match whatever ENCRYPTION_KEY is set to in the existing Firebase
# Functions config (functions:config or Secret Manager), so this service
# can decrypt org Nedarim credentials the same way. 32+ characters.
ENCRYPTION_KEY=

# Optional - only needed if you already use CALLBACK_SECRET validation
# on the Nedarim webhook.
CALLBACK_SECRET=
